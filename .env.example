# Site URL for metadata (Open Graph, canonical) + Stripe redirect URLs
NEXT_PUBLIC_SITE_URL=https://1320soulcode.com

# Optional — Google Analytics 4
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Log analytics events in production (debug only)
# NEXT_PUBLIC_ANALYTICS_DEBUG=false

# Log calculator submit steps to browser console (for mobile QA)
# NEXT_PUBLIC_DEBUG_CALCULATOR=true

# Show report debug panel (resolved keys, combination signature)
# NEXT_PUBLIC_REPORT_DEBUG=true

# --- v2 content cutover (S0–S9 spec pack) ---
# When true, get1320Content uses web/data/1320-v2 (Phase 3+). Default: v1 data/1320.
# USE_1320_V2_CONTENT=true

# --- Phase 2A: database (Neon / Vercel Postgres) ---
# POSTGRES_URL=postgresql://user:pass@host/db?sslmode=require

# --- Phase 2A: Stripe one-time Full Report checkout ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_FULL_REPORT_AMOUNT_CENTS=4900
# Or use a Stripe Price ID (price_..., NOT prod_...) instead of amount:
# STRIPE_FULL_REPORT_PRICE_ID=price_...

# --- Personal Integration Session booking (Launch v1 · USD) ---
# Defaults in code: Blueprint 11900 / Focused Life 15900 / Deep 20900 (cents USD).
# STRIPE_BOOKING_BLUEPRINT_INTEGRATION_AMOUNT_CENTS=11900
# STRIPE_BOOKING_FOCUSED_LIFE_AMOUNT_CENTS=15900
# STRIPE_BOOKING_DEEP_BLUEPRINT_AMOUNT_CENTS=20900
# Optional Price IDs — must be USD currency in Stripe Dashboard.
# If a Price ID is AUD (or non-USD), Checkout will charge that currency even when UI shows USD.
# Prefer omitting Price IDs to use price_data USD path, or recreate USD prices.
# STRIPE_BOOKING_BLUEPRINT_INTEGRATION_PRICE_ID=price_...
# STRIPE_BOOKING_FOCUSED_LIFE_PRICE_ID=price_...
# STRIPE_BOOKING_DEEP_BLUEPRINT_PRICE_ID=price_...
# Post-payment scheduling calendar (Cal.com / Calendly):
# BOOKING_SCHEDULE_URL=https://cal.com/your-link
# BOOKING_SCHEDULE_URL_BLUEPRINT_INTEGRATION=
# BOOKING_SCHEDULE_URL_FOCUSED_LIFE=
# BOOKING_SCHEDULE_URL_DEEP_BLUEPRINT=

# --- Phase 2A: magic-link email (optional; logs link in dev if unset) ---
# RESEND_API_KEY=re_...
# EMAIL_FROM=1320 Soul Code <noreply@1320soulcode.com>

# --- Wisewave Reflect (OpenAI LLM responses) ---
# When set, Wisewave uses OpenAI for response text; falls back to rule-based if unset or on error.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Blueprint Experience API (Coze / 扣子 bridge) ---
# Dedicated server-to-server key. Never put this in prompts or client code.
# BLUEPRINT_EXPERIENCE_API_KEY=replace-with-dedicated-coze-key
# Optional HMAC secret for blueprint_id signing (defaults to API key if unset).
# BLUEPRINT_EXPERIENCE_ID_SECRET=replace-with-rotation-friendly-secret
# Comma-separated allowed X-Client-Id values (default: coze-lifestyle-v1)
# BLUEPRINT_EXPERIENCE_ALLOWED_CLIENTS=coze-lifestyle-v1

# Deprecated — Phase 2A uses POSTGRES_URL instead of webhook forwarding
# LEADS_WEBHOOK_URL=https://your-webhook.example/leads
