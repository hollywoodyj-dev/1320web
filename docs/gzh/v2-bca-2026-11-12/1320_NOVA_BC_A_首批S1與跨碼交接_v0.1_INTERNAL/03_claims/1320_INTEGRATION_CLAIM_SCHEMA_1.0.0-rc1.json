{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:1320:integration-claim:1.0.0-rc1",
  "title": "1320 Internal Cross-Code Integration Claim — Proposed",
  "description": "INTERNAL ONLY. Narrative candidate; never send source anchors to customer endpoints. Cross-field checks enforced in service; APPROVED requires human signoff.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "integration_id",
    "source_snapshot_id",
    "rule_set_version",
    "code_ids",
    "relation_type",
    "anchors",
    "editorial_relation_reason",
    "scenario_status",
    "reader_claim_status",
    "customer_text_zh_tw",
    "editorial_status",
    "locale"
  ],
  "properties": {
    "integration_id": {
      "type": "string",
      "minLength": 3
    },
    "source_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "rule_set_version": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "const": "zh-TW"
    },
    "code_ids": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "string",
        "pattern": "^S([0-9])-[0-9]{2}$"
      }
    },
    "relation_type": {
      "enum": [
        "REINFORCEMENT",
        "TENSION",
        "BRIDGE",
        "GROUNDING"
      ]
    },
    "anchors": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "source_field",
          "approval_id"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^S([0-9])-[0-9]{2}$"
          },
          "source_field": {
            "type": "string",
            "minLength": 4
          },
          "approval_id": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "editorial_relation_reason": {
      "type": "string",
      "minLength": 25
    },
    "scenario_status": {
      "const": "HYPOTHETICAL"
    },
    "reader_claim_status": {
      "const": "NO_INFERRED_HISTORY"
    },
    "customer_text_zh_tw": {
      "type": "string",
      "minLength": 25
    },
    "reader_prompt_zh_tw": {
      "type": "string",
      "minLength": 5
    },
    "editorial_status": {
      "enum": [
        "PENDING_REVIEW",
        "NEEDS_REVISION",
        "APPROVED",
        "REJECTED"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 2
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes_internal": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "editorial_status": {
            "const": "APPROVED"
          }
        },
        "required": [
          "editorial_status"
        ]
      },
      "then": {
        "required": [
          "reviewer",
          "approved_at"
        ]
      }
    }
  ]
}